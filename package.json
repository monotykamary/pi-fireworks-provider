{
  "name": "pi-fireworks-provider",
  "version": "1.7.11",
  "description": "Fireworks AI provider extension for pi - Access Kimi, MiniMax, GLM, DeepSeek, and GPT-OSS models through the Fireworks AI API",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && vitest run && knip --no-gitignore",
    "lint:dead": "knip --no-gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "fireworks",
    "fireworks-ai",
    "ai",
    "llm",
    "kimi",
    "minimax",
    "glm",
    "deepseek"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "index.ts",
    "sync-policy.ts",
    "models.json",
    "deprecated-models.json",
    "custom-models.json",
    "patch.json",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.20.0",
    "knip": "6.14.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-fireworks-provider.git"
  }
}
